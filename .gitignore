# ── Credential & secret files ─────────────────────────────────────────────────
# These files hold live keys, tokens, and client secrets.
# See docs/repo-setup.md for how to generate them from their .template counterparts.
api-key-config.json
entra-oauth-config.json
konnect-connection.json

# Operator-specific docs that embed live credentials generated during setup.
# Use the .template source docs in docs/ instead.
docs/foundry-key-auth-setup.md
docs/mcp-inspector-setup.md

# Environment variable files
.env
.env.*
*.env

# ── Downloaded tool binaries ───────────────────────────────────────────────────
# Binaries are fetched by scripts/setup-repo.ps1 and should not be committed.
# See docs/repo-setup.md for tool installation instructions.
tools/

# ── Generated output ───────────────────────────────────────────────────────────
scripts/.generated/

# ── Node dependency directories ────────────────────────────────────────────────
node_modules/
mcp-server/node_modules/
mock-api/node_modules/

# ── Squad: ignore runtime state (logs, inbox, sessions) ───────────────────────
.squad/orchestration-log/
.squad/log/
.squad/decisions/inbox/
.squad/sessions/
.squad/.scratch/
# Squad: SubSquad activation file (local to this machine)
.squad-workstream
