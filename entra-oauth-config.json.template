{
  "_instructions": "Copy this file to entra-oauth-config.json and fill in the values from your Azure Entra app registrations. See docs/entra-app-registration.md for setup steps.",
  "tenant_id": "<YOUR_AZURE_TENANT_ID>",
  "resource_api_app_id": "<RESOURCE_API_APP_ID from Entra app registration>",
